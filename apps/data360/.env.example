# Copy to .env.local for local dev. On Vercel, set the same keys in
# Project → Settings → Environment Variables (Production / Preview / Development).

# --- Required ---
# Random ≥32 chars. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Public URL of the deployment.
# Locally: http://localhost:3000
# On Vercel: leave blank — env.mjs falls back to https://$VERCEL_URL automatically.
NEXTAUTH_URL=http://localhost:3000

# Backend API base URL (exposed to the browser).
NEXT_PUBLIC_API_URL=http://api.datalab360.io

# --- Optional ---
NEXT_PUBLIC_APP_NAME=Data360
NEXT_PUBLIC_GOOGLE_MAP_API_KEY=

# Email (SMTP) — only needed if email features are enabled.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Google OAuth — only needed if Google sign-in is enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
